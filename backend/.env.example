# Server
PORT=8080
NODE_ENV=development

# MongoDB Atlas cluster connection string
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/bloomandbliss?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/bloomandbliss?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Google Sign-In (OAuth) - create a Web OAuth Client ID in Google Cloud Console
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# CORS - the URL where the React frontend runs
CLIENT_URL=http://localhost:5173
